{
  "name": "hearth",
  "version": "0.5.0",
  "private": true,
  "description": "Self-hosted Personal Relationship Manager with extensible fields and one-way Google sync",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p scripts/e2e --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "docker:up": "sh scripts/docker-up.sh",
    "preversion": "npm run typecheck",
    "version": "node scripts/release-changelog.mjs && git add CHANGELOG.md",
    "e2e": "next build && tsx scripts/e2e/verify.mts",
    "token": "tsx scripts/e2e/get-token.mts",
    "e2e:google": "tsx scripts/e2e/google.mts"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.19.3",
    "googleapis": "174.0.1",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.4",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "embedded-postgres": "16.14.0-beta.17",
    "playwright-core": "1.62.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
