# Credentials for the end-to-end tests that talk to real Google accounts.
#
# Copy this file to .env.e2e and fill in the two values from your THROWAWAY GCP
# project's OAuth client — not the production one that serves your real install.
#
#   cp .env.e2e.example .env.e2e
#
# .env.e2e is gitignored. This example file is not, and must never hold real values.

E2E_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
E2E_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Everything below is written FOR you by `npm run token`. Leave it out; do not type
# the account emails by hand. Which account a token belongs to is decided by which
# Google account you sign into in the browser, and the script reads the address back
# from Google so the two can never disagree.
#
#   npm run token -- A     # then sign in as the first dummy account
#   npm run token -- B     # then sign in as the second
#
# E2E_REFRESH_TOKEN_A=1//...
# E2E_EMAIL_A=first-dummy@gmail.com
# E2E_REFRESH_TOKEN_B=1//...
# E2E_EMAIL_B=second-dummy@gmail.com
