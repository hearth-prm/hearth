# ---------------------------------------------------------------------------
# Hearth configuration
#
# Copy to .env and fill in. docker-compose reads this file automatically.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Credentials for the bundled Postgres container. Change POSTGRES_PASSWORD.
POSTGRES_USER=hearth
POSTGRES_PASSWORD=change-me-before-you-deploy
POSTGRES_DB=hearth

# Connection string used by the app. The host "db" is the compose service name.
# If you run the app outside compose, point this at localhost:5432 instead.
DATABASE_URL=postgresql://hearth:change-me-before-you-deploy@db:5432/hearth?schema=public

# Where Postgres keeps its data. Leave blank to use a Docker named volume.
# Set an absolute path to bind-mount instead — do this on Unraid/Synology, where
# the Docker volume store is on a fixed-size image that a Docker reset wipes.
# On Unraid this is normally the appdata share:
#   PGDATA_PATH=/mnt/user/appdata/hearth/postgres
# Pointing it at a pool directly bypasses the FUSE layer, which matters because
# Postgres is fsync-heavy. Pool names vary — find yours with:
#   awk '$2 ~ /^\/mnt\// {print $2, $3}' /proc/mounts
PGDATA_PATH=

# --- Auth.js --------------------------------------------------------------
# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Public origin of your Hearth install, no trailing slash. Must match the
# redirect URI you registered in Google Cloud Console.
AUTH_URL=http://localhost:3000
# Required when running behind a reverse proxy (Caddy, nginx, Traefik).
AUTH_TRUST_HOST=true

# --- Google OAuth ---------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth 2.0 Client ID (type: Web application).
# Authorised redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Place search (optional) ----------------------------------------------
# The event location field offers place suggestions. OpenStreetMap is used by
# default and needs nothing. Setting a Google Places key switches to Google, which
# is better for small venues but requires billing enabled on the Cloud project.
# The key is only ever used server-side; it is never sent to the browser.
#GOOGLE_PLACES_API_KEY=

# --- Background sync ------------------------------------------------------
# The push to Google runs inside the app process on a timer. Set false to stop
# the scheduler (the "Sync now" button still works).
#SYNC_ENABLED=true
# How often to look for changed contacts. Minimum 30.
#SYNC_INTERVAL_SECONDS=300

# --- App ------------------------------------------------------------------
# Port published on the host.
APP_PORT=3000

# Interface the port is published on. Leave unset for all interfaces.
# Behind a reverse proxy on a shared Docker network, set 127.0.0.1 so the only
# way in is through the proxy (and therefore through TLS).
#APP_BIND=127.0.0.1

# --- Reverse proxy (SWAG / NPM / Traefik) ---------------------------------
# Uncomment both to join your proxy's Docker network, so it can reach Hearth by
# container name (hearth-app:3000). See docker-compose.proxy.yml and
# deploy/swag/hearth.subdomain.conf.
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
#PROXY_NETWORK=proxynet

# --- Search in words (optional) -------------------------------------------
#
# A model on your own network turns a sentence into a search query. With OLLAMA_URL
# unset the feature is not offered at all and everything else works as before; set
# but unreachable, the ordinary search still works and the box says the model could
# not be reached.
#
# Only the sentence, the field names and your label names are sent, and only to the
# host named here. Ollama runs as its own container — never bundled into Hearth's
# image, because on Unraid the model weights would land in docker.img.
#
#   ollama pull qwen2.5:7b-instruct
#
# A long OLLAMA_KEEP_ALIVE on the Ollama side keeps the model resident, so the first
# search of the day is as fast as the tenth.
# --- the image ------------------------------------------------------------
#
# Which published image to run. Pin HEARTH_TAG to a version for a reproducible
# install; `latest` follows releases. `edge` is built from every commit to main
# and is for people who want to help find bugs.
#HEARTH_IMAGE=registry.gitlab.com/hammerling/hearth
#HEARTH_TAG=latest

# --- thank-you emails (optional) ------------------------------------------
#
# Hearth can email a thank-you list as you, which needs Google's gmail.send
# scope. OFF by default, and the scope is not even requested unless this is
# true: Gmail scopes are the category Google controls most tightly, and most
# installs will never email a thank-you. Set it, then reconnect Google.
#HEARTH_ENABLE_MAIL=true

# --- who may sign in ------------------------------------------------------
#
# Comma-separated addresses, or @domain for anyone at that domain:
#
#   HEARTH_ALLOWED_EMAILS=you@gmail.com, partner@gmail.com, @yourfamily.example
#
# The rules, in order: somebody who already has an account may always sign in; if
# the install has no users at all, the first sign-in claims it; otherwise the
# address has to match this list.
#
# Leaving it unset is safe — nobody new can join an install that already has a
# user — but SET IT BEFORE FIRST BOOT if the install is reachable from the
# internet, or the first stranger to find it claims the install instead of you.
#
# Removing somebody's access means removing the user, not editing this: a typo
# here must never lock you out of your own Hearth.
#HEARTH_ALLOWED_EMAILS=

# Where this install's source can be obtained, offered in the footer because the
# AGPL asks for it. Leave unset when running Hearth unmodified; point it at your
# own repository if you have changed anything.
#HEARTH_SOURCE_URL=

#OLLAMA_URL=http://192.168.1.10:11434
#OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct

# The same host also powers `semantic:` — searching by meaning rather than by
# spelling, so `semantic:healthcare` finds "Registered Nurse at UW Health".
#
#   ollama pull nomic-embed-text
#
# Contacts are turned into vectors in the background, a few minutes after boot and
# every few minutes after that. Settings shows how many are indexed and has an
# "Index now" button. Changing this model re-embeds everything, because a vector is
# only comparable to others from the same model.
#OLLAMA_EMBED_MODEL=nomic-embed-text
#SEARCH_INDEX_INTERVAL_SECONDS=300
