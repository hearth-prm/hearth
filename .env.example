# ---------------------------------------------------------------------------
# Hearth configuration
#
# Copy to .env and fill in. docker-compose reads this file automatically.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Credentials for the bundled Postgres container. Change POSTGRES_PASSWORD.
POSTGRES_USER=hearth
POSTGRES_PASSWORD=change-me-before-you-deploy
POSTGRES_DB=hearth

# Connection string used by the app. The host "db" is the compose service name.
# If you run the app outside compose, point this at localhost:5432 instead.
DATABASE_URL=postgresql://hearth:change-me-before-you-deploy@db:5432/hearth?schema=public

# Where Postgres keeps its data. Leave blank to use a Docker named volume.
# Set an absolute path to bind-mount instead — do this on Unraid/Synology, where
# the Docker volume store is on a fixed-size image that a Docker reset wipes.
# On Unraid, point at the pool directly rather than /mnt/user (see README):
#   PGDATA_PATH=/mnt/cache/appdata/hearth/postgres
PGDATA_PATH=

# --- Auth.js --------------------------------------------------------------
# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Public origin of your Hearth install, no trailing slash. Must match the
# redirect URI you registered in Google Cloud Console.
AUTH_URL=http://localhost:3000
# Required when running behind a reverse proxy (Caddy, nginx, Traefik).
AUTH_TRUST_HOST=true

# --- Google OAuth ---------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth 2.0 Client ID (type: Web application).
# Authorised redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- App ------------------------------------------------------------------
# Port published on the host.
APP_PORT=3000
