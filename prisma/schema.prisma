// Hearth — self-hosted Personal Relationship Manager
//
// Schema conventions
// -----------------
// * Every user-owned row carries `ownerId`. Read access is always funnelled
//   through the helpers in src/lib/access.ts so that record sharing (M4) can be
//   introduced by changing one file rather than every query.
// * "Core" fields on Person/Event are real columns. User-defined fields live in
//   the `custom` JSONB column and are described by FieldDefinition rows. See
//   src/lib/fields/ for the registry that unifies the two.
// * Google sync state is stored inline on the synced entity. Deletions and
//   opt-outs record a SyncTombstone so the remote copy can still be found and
//   removed after the local row is gone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models — shapes are dictated by @auth/prisma-adapter
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// Owns the household cards — the contact record representing each user.
  ///
  /// A flag on User rather than an install-level settings row, because "who is the head"
  /// is a fact about a person and there is exactly one of them: a partial unique index
  /// enforces that in the database rather than in application code that could forget.
  /// The first user to sign in becomes head, and it can be handed over in settings.
  isHeadOfHousehold Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  settings          UserSettings?
  people            Person[]
  events            Event[]
  relationships     Relationship[]
  relationshipTypes RelationshipType[]
  fieldDefinitions  FieldDefinition[]
  fieldMappings     FieldMapping[]
  tombstones        SyncTombstone[]
  sharesGiven       Share[]            @relation("SharesGiven")
  sharesReceived    Share[]            @relation("SharesReceived")
  personSyncs       PersonSync[]
  labels            Label[]
  labelGroups       LabelGroup[]
  personPhotos      PersonPhoto[]
  personVersions    PersonVersion[]
  contactCard       Person?            @relation("UserContactCard")
  giftsRecorded     Gift[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Per-user preferences
// ---------------------------------------------------------------------------

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  /// Master switch for the one-way PRM -> Google Contacts push.
  syncContactsEnabled Boolean @default(false)
  /// Master switch for PRM <-> Google Calendar event sync.
  syncCalendarEnabled Boolean @default(false)
  /// Push contacts other people shared with you into YOUR Google Contacts too.
  ///
  /// On by default, because that is the point of sharing a contact: one Hearth
  /// record, everyone's address book. Off for anyone who would rather not have a
  /// partner's five hundred contacts land in their own Google account.
  syncSharedContacts  Boolean @default(true)
  /// Value pre-filled into "Add to Google" on newly created *contacts*.
  /// Events deliberately do not follow this: see Event.addToGoogle.
  defaultAddToGoogle  Boolean @default(true)
  /// Target calendar for pushed events; "primary" unless the user picks another.
  googleCalendarId    String  @default("primary")
  /// Invite people added to a PRM event as Google Calendar attendees.
  inviteAttendees     Boolean @default(true)
  /// Pull RSVP responses from Google back into EventAttendee.rsvp.
  importRsvps         Boolean @default(true)
  /// Let Google email guests when an event is created or changed.
  ///
  /// On by default, because a guest who is never emailed can never RSVP, and the
  /// RSVP writeback is the point of inviting them. This is only safe because an
  /// event reaches Google solely when someone ticks "Send to Google" on it — see
  /// Event.addToGoogle. As a further guard, notifications stay suppressed for
  /// events that have already finished even when this is on.
  sendInvites         Boolean @default(true)
  /// IANA zone used when creating events and rendering times.
  timeZone            String  @default("UTC")

  /// Lets the head of the household write this user's thank-yous for them.
  ///
  /// Off by default and given by the user themselves, because a thank-you is signed by
  /// whoever sends it: this is permission to speak for somebody, which only they can
  /// grant. It exists so a parent can write a small child's notes.
  allowHeadThankYous  Boolean @default(false)

  /// light | dark | system. "system" stores nothing on the html element and lets
  /// prefers-color-scheme decide, which is why it is a third value rather than a
  /// boolean: "follow my machine" is a real preference, not the absence of one.
  theme               String  @default("system")
  /// Accent in light mode: a named scheme, or "custom" to use lightAccentHue.
  lightColorScheme    String  @default("teal")
  /// Hue in degrees for a scheme the user mixed themselves. The whole palette is
  /// derived from it in oklch, so a bespoke scheme costs one number rather than
  /// eleven colours that have to look evenly spaced by hand.
  lightAccentHue      Int     @default(184)
  /// And the same pair for dark mode. Two accents rather than one because a hue that
  /// carries on white is often muddy on near-black; which pair applies is decided by
  /// a CSS rule, since under "system" only the browser knows the mode.
  darkColorScheme     String  @default("teal")
  darkAccentHue       Int     @default(184)

  /// Which service backs place search on the event location field.
  ///
  /// "auto" uses Google Places when GOOGLE_PLACES_API_KEY is set and OpenStreetMap
  /// otherwise. The API key itself lives in the environment, not here: it is
  /// operator configuration like the OAuth secrets, one key serves every user of an
  /// install, and a secret in a table ends up in every database backup.
  /// One of: auto | osm | google | off
  placesProvider      String  @default("auto")

  /// Set when Google refuses the stored refresh token (revoked access, changed
  /// password, expired consent). Sync stops rather than retrying forever, and the
  /// UI prompts a reconnect. Cleared on the next successful authorisation.
  googleAuthError   String?
  googleAuthErrorAt DateTime?

  /// Outcome of the last contacts push, for the settings page.
  lastContactSyncAt      DateTime?
  lastContactSyncSummary String?

  /// Outcome of the last calendar push.
  lastEventSyncAt      DateTime?
  lastEventSyncSummary String?

  /// Watermark for the RSVP poll. Google's events.list accepts `updatedMin`, so
  /// one call per run returns every event changed since this instant — far cheaper
  /// than fetching each synced event individually.
  calendarRsvpCheckedAt DateTime?

  /// Lease preventing two sync runs for this user at once — the scheduled loop
  /// and a manual "Sync now" can otherwise overlap. A lease rather than a
  /// Postgres advisory lock because those are per-connection and Prisma pools
  /// connections, so a lock taken on one and released on another would leak.
  /// Expiry also means a crashed run cannot block sync forever.
  syncLockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Extensible field registry
// ---------------------------------------------------------------------------

enum FieldEntity {
  PERSON
  EVENT
}

enum FieldType {
  TEXT
  LONGTEXT
  NUMBER
  DATE
  DATETIME
  BOOLEAN
  SELECT
  MULTISELECT
  EMAIL
  PHONE
  URL
}

/// A user-defined field added to Person or Event. Values are stored under
/// `key` inside the entity's `custom` JSONB column. Core (built-in) fields are
/// NOT rows here — they are declared in src/lib/fields/core.ts, because their
/// existence and storage location are fixed by the Prisma schema itself.
model FieldDefinition {
  id      String      @id @default(cuid())
  ownerId String
  entity  FieldEntity
  /// snake_case identifier, unique per owner+entity, also the JSONB key.
  key     String
  label   String
  type    FieldType
  /// Allowed values for SELECT / MULTISELECT.
  options String[]    @default([])
  helpText String?
  required Boolean    @default(false)
  /// Show on list views / cards.
  showInList Boolean  @default(false)
  order    Int        @default(0)
  /// Archived fields keep their stored values but disappear from forms.
  archived Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, entity, key])
  @@index([ownerId, entity, archived])
}

/// Where one Hearth field is written in Google.
///
/// Replaces the all-or-nothing `UserSettings.syncCustomFields`: each user-defined
/// field now chooses its own destination, or none at all.
///
/// The absence of a row means different things by design:
///   * a CUSTOM field with no row is not synced — "off" is the safe default for
///     anything newly added, so a new field never silently exports itself;
///   * a CORE field with no row keeps its canonical mapping from
///     src/lib/google/serialize-*.ts.
///
/// Core fields therefore cannot be re-targeted: givenName -> names.givenName is
/// structural, and allowing it to be pointed elsewhere would let someone produce a
/// nameless Google contact. They can only be switched OFF, with a row whose target
/// is "none" — which is worth having, since notes in particular are often something
/// people would rather not copy into Google.
model FieldMapping {
  id      String      @id @default(cuid())
  ownerId String
  entity  FieldEntity
  /// Registry key, core or custom. Not a foreign key: core fields live in code.
  fieldKey String
  /// Target id from src/lib/google/mapping-targets.ts.
  target  String
  /// The Google-side name, for targets that need one (a custom field's key).
  /// Defaults to the field's label when blank.
  targetKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, entity, fieldKey])
  @@index([ownerId, entity])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum SyncStatus {
  /// Local changes not yet pushed.
  PENDING
  /// Remote copy matches the last local write.
  SYNCED
  /// Last push failed; see googleSyncError.
  ERROR
  /// addToGoogle is false — intentionally not synced.
  DISABLED
}

model Person {
  id      String @id @default(cuid())
  ownerId String

  /// Set on a household card: the user this contact represents.
  ///
  /// Unique, so a user can never accumulate two cards. This is what lets Hearth answer
  /// "did my wife give me this?" without the user hand-picking her own contact record
  /// every time.
  ///
  /// These cards are owned by the head of the household and shared with every user,
  /// including the one each card is about — so your own details land in your own Google
  /// Contacts, where your phone's "share contact" can send them to anyone.
  linkedUserId String? @unique

  // --- core fields (mirrored in src/lib/fields/core.ts) ---
  givenName    String?
  familyName   String?
  nickname     String?
  organization String?
  jobTitle     String?
  birthday     DateTime? @db.Date
  notes        String?   @db.Text

  /// The rest of a Google name.
  ///
  /// Real columns rather than custom fields, because Hearth manages the `names` group
  /// and replaces it wholesale on every push — so a middle name it did not store was a
  /// middle name it deleted, on the next sync, from the contact it had just imported.
  middleName         String?
  honorificPrefix    String?
  honorificSuffix    String?
  phoneticGivenName  String?
  phoneticMiddleName String?
  phoneticFamilyName String?

  /// Google keeps a gender as free text, so Hearth does too rather than inventing an
  /// enum somebody's real answer would not fit.
  gender             String?

  /// A birthday Google holds without a year, or as prose.
  ///
  /// `birthday` is a @db.Date and cannot express "the 3rd of April, year unknown", which
  /// is how a great many contacts are actually recorded. The import used to report those
  /// as unstorable and drop them.
  birthdayText       String?

  /// The rest of the primary organisation, for the same reason.
  ///
  /// One organisation, not a list: Hearth has only ever sent one, so nothing regresses,
  /// and `organization`/`jobTitle` stay where every core-field, CSV and search path
  /// already expects them. A contact with two employers still loses the second — noted
  /// rather than pretended away.
  orgDepartment     String?
  orgJobDescription String?
  orgSymbol         String?
  orgDomain         String?
  orgLocation       String?
  orgPhoneticName   String?
  orgType           String?

  /// Denormalised "Given Family" (or nickname/org fallback) for sort + search.
  displayName String @default("")

  /// User-defined field values, keyed by FieldDefinition.key.
  custom Json @default("{}")

  // --- Google Contacts sync ---
  /// The owner's decision that this contact belongs in Google at all.
  ///
  /// Whether it reaches a *particular* Google account is then per user: see
  /// PersonSync, one row per (contact, account). A shared contact lands in every
  /// recipient's address book, which is why the resource id cannot live here.
  addToGoogle          Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Cascade: deleting a user takes the card that represents them with it.
  linkedUser        User?           @relation("UserContactCard", fields: [linkedUserId], references: [id], onDelete: Cascade)
  contactPoints     ContactPoint[]
  relationshipsFrom Relationship[]  @relation("RelationshipFrom")
  relationshipsTo   Relationship[]  @relation("RelationshipTo")
  eventAttendances  EventAttendee[]
  shares            Share[]
  googleSyncs       PersonSync[]
  labels            PersonLabel[]
  photos            PersonPhoto[]
  versions          PersonVersion[]
  googleEvents      PersonGoogleEvent[]
  googleRelations   PersonGoogleRelation[]
  giftsGiven        Gift[]          @relation("GiftGiver")
  giftsReceived     GiftRecipient[] @relation("GiftRecipient")
  giftEvents        EventGiftRecipient[]

  @@index([linkedUserId])
  @@index([ownerId, displayName])
  @@index([ownerId, updatedAt])
  @@index([ownerId, addToGoogle])
  @@index([custom(ops: JsonbOps)], type: Gin)
}

/// One contact's copy in one Google account.
///
/// Sync state has to be per (contact, account) rather than per contact, because a
/// shared contact exists in every recipient's Google Contacts: each copy has its
/// own resource id, its own etag, and can fail or fall behind independently of the
/// others. Keeping it on the Person row allowed exactly one copy — the owner's —
/// which made sharing invisible to Google.
model PersonSync {
  id       String @id @default(cuid())
  personId String
  /// Whose Google account this copy lives in. Not necessarily the contact's owner.
  userId   String

  googleResourceName      String?
  googleEtag              String?
  googleSyncedAt          DateTime?
  googleSyncStatus        SyncStatus @default(PENDING)
  /// etag of the photo last pushed to THIS account, or null if none has been.
  /// Photos go through a separate People API call from the field update, so a
  /// separate record of what was sent is what stops every sync re-uploading them.
  googlePhotoEtag         String?
  googleSyncError         String?    @db.Text
  /// Consecutive failed pushes for THIS account, driving its own backoff.
  googleSyncAttempts      Int        @default(0)
  googleSyncNextAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([personId, userId])
  /// One Hearth contact per Google resource, per account.
  @@unique([userId, googleResourceName])
  /// Drives the sync queue for one account.
  @@index([userId, googleSyncStatus, googleSyncNextAttemptAt])
}

enum ContactKind {
  EMAIL
  PHONE
  URL
  ADDRESS
  SOCIAL

  // --- the rest of what Google keeps as a list of value-and-type -------------
  //
  // Kinds rather than a table each: every one of these is a value with an optional
  // type, which is exactly what ContactPoint already is — so they inherit its
  // ordering, its primary flag and the editor that renders it. A table apiece would
  // have been eight schemas, eight forms and eight sync paths for the same shape.
  IM
  SIP
  CALENDAR
  EXTERNAL_ID
  KEYWORD
  INTEREST
  SKILL
  OCCUPATION
  LOCATION
  NICKNAME
}

/// Repeatable contact details. Modelled as rows rather than columns because
/// Google People API stores these as arrays with per-entry types, and a person
/// legitimately has several (work email, home phone, ...).
model ContactPoint {
  id       String      @id @default(cuid())
  personId String
  kind     ContactKind
  /// Free-text type: "home", "work", "mobile", "linkedin", ...
  label    String?
  value    String
  isPrimary Boolean    @default(false)
  order    Int         @default(0)

  /// The parts of an address, for kind = ADDRESS.
  ///
  /// `value` stays the one line Hearth shows and searches; these carry the structure
  /// Google keeps beside it. Both are sent: Google builds formattedValue from the parts
  /// when it is absent, so keeping the line means a Hearth-typed address still reads
  /// correctly, and keeping the parts means an imported one is not flattened by the
  /// first sync — which is what used to happen to every address Hearth touched.
  poBox           String?
  streetAddress   String?
  extendedAddress String?
  city            String?
  region          String?
  postalCode      String?
  country         String?
  countryCode     String?

  /// Google's own display name for an email address, kept for the same reason.
  displayName     String?

  /// Which chat network an IM handle belongs to.
  protocol        String?

  /// Where a LOCATION is, as Google files it: desk, floor, building.
  buildingId      String?
  floor           String?
  floorSection    String?
  deskCode        String?
  /// Google marks one location as the current one.
  current         Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, kind, order])
  @@index([value])
}

// ---------------------------------------------------------------------------
// Relationships
// ---------------------------------------------------------------------------

/// A kind of link between two people. Rows with ownerId = null are the seeded
/// system types available to everyone; users may add their own.
model RelationshipType {
  id      String  @id @default(cuid())
  ownerId String?
  key     String
  /// Reads from -> to, e.g. "Parent of".
  label   String
  /// Reads to -> from, e.g. "Child of". Equals `label` when symmetric.
  inverseLabel String
  /// True when direction carries no meaning (spouse, sibling, friend).
  symmetric Boolean @default(false)
  order   Int     @default(0)

  createdAt DateTime @default(now())

  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  relationships Relationship[]

  @@unique([ownerId, key])
  @@index([ownerId])
}

model Relationship {
  id           String  @id @default(cuid())
  ownerId      String
  fromPersonId String
  toPersonId   String
  typeId       String
  notes        String? @db.Text
  startedOn    DateTime? @db.Date
  endedOn      DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  from  Person           @relation("RelationshipFrom", fields: [fromPersonId], references: [id], onDelete: Cascade)
  to    Person           @relation("RelationshipTo", fields: [toPersonId], references: [id], onDelete: Cascade)
  type  RelationshipType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@unique([fromPersonId, toPersonId, typeId])
  @@index([ownerId])
  @@index([toPersonId])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

model Event {
  id      String @id @default(cuid())
  ownerId String

  // --- core fields (mirrored in src/lib/fields/core.ts) ---
  title       String
  description String?   @db.Text
  location    String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  timeZone    String    @default("UTC")

  /// User-defined field values, keyed by FieldDefinition.key.
  custom Json @default("{}")

  // --- Google Calendar sync state ---
  /// Whether this event belongs on the user's Google Calendar.
  ///
  /// Defaults to FALSE, unlike Person.addToGoogle. Most of what Hearth records is
  /// history — who was at a gathering — and history does not belong on a calendar,
  /// least of all with invitations attached. Sending an event to Google is
  /// therefore an explicit per-event choice, which also means notifications can
  /// default on without risk.
  addToGoogle      Boolean    @default(false)
  googleEventId    String?
  googleCalendarId String?
  googleEtag       String?
  /// The canonical link Google returns for the event. Stored rather than
  /// constructed: the shareable "eid" is base64 of "<eventId> <calendar email>",
  /// and for the primary calendar that email is the account's own address, not the
  /// literal string "primary" — so building it by hand produced a 500.
  googleHtmlLink   String?
  googleSyncedAt   DateTime?
  googleSyncStatus SyncStatus @default(PENDING)
  googleSyncError  String?    @db.Text
  /// Consecutive failed pushes, driving exponential backoff.
  googleSyncAttempts      Int       @default(0)
  /// Earliest time this event should be tried again. Null means "now".
  googleSyncNextAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  attendees      EventAttendee[]
  shares         Share[]
  gifts          Gift[]
  giftRecipients EventGiftRecipient[]

  @@index([ownerId, startAt])
  /// Drives the sync queue: pending/errored events whose backoff has elapsed.
  @@index([ownerId, addToGoogle, googleSyncStatus, googleSyncNextAttemptAt])
  @@unique([ownerId, googleCalendarId, googleEventId])
  @@index([custom(ops: JsonbOps)], type: Gin)
}

enum AttendeeRole {
  HOST
  REQUIRED
  OPTIONAL
}

enum RsvpStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

model EventAttendee {
  id       String @id @default(cuid())
  eventId  String
  personId String

  role AttendeeRole @default(OPTIONAL)
  rsvp RsvpStatus   @default(NEEDS_ACTION)
  notes String?     @db.Text

  /// Include this person as an attendee on the Google Calendar event.
  inviteToGoogle Boolean @default(true)
  /// Email actually used on the Google invite — RSVP pulls match on this.
  googleInviteEmail String?
  /// Set when rsvp was last updated from Google rather than in the PRM.
  rsvpFromGoogleAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Sharing
// ---------------------------------------------------------------------------

enum SharePermission {
  /// See the record. Cannot change it.
  VIEW
  /// See and change it. Deleting stays with the owner.
  EDIT
}

enum ShareScope {
  /// Every contact this owner has, including ones added later.
  ALL_PEOPLE
  /// Every event this owner has, including ones added later.
  ALL_EVENTS
  /// One named contact.
  PERSON
  /// One named event.
  EVENT
}

/// A grant from one user to another.
///
/// Blanket scopes exist as well as per-record ones because "share my whole address
/// book with my partner" is a different intention from "show them this one
/// contact", and expressing the first as thousands of rows would mean every newly
/// added contact needed remembering.
///
/// Deliberately not a unique constraint across the scope columns: Postgres treats
/// NULLs as distinct, so a constraint spanning personId/eventId would not actually
/// prevent duplicates. The action checks instead.
model Share {
  id         String          @id @default(cuid())
  ownerId    String
  withUserId String
  scope      ShareScope
  permission SharePermission @default(VIEW)

  /// Set for scope PERSON.
  personId String?
  /// Set for scope EVENT.
  eventId  String?

  createdAt DateTime @default(now())

  owner    User    @relation("SharesGiven", fields: [ownerId], references: [id], onDelete: Cascade)
  withUser User    @relation("SharesReceived", fields: [withUserId], references: [id], onDelete: Cascade)
  person   Person? @relation(fields: [personId], references: [id], onDelete: Cascade)
  event    Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([withUserId, scope])
  @@index([ownerId])
  @@index([personId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Photos
// ---------------------------------------------------------------------------

/// A contact's picture.
///
/// Deliberately the one piece of contact data that is NOT uniform across viewers. The
/// owner's photo is the default and flows through to everyone the contact is shared
/// with, but a recipient may set their own instead: a photo is how you recognise
/// somebody, and the picture that does that job is personal in a way a job title is
/// not. Every other field follows the owner precisely because one record should read
/// the same to everyone — see the labels and field-registry rules, which this breaks
/// on purpose.
///
/// One row per (contact, user). The owner's row is the one whose userId matches the
/// contact's ownerId; a row for anyone else is that person's override.
///
/// Bytes live in Postgres rather than on disk so that the verified pg_dump
/// update-hearth.sh already takes before every update carries them too. A separate
/// upload directory would need its own backup story, and the one that gets forgotten
/// is the one that matters.
model PersonPhoto {
  id       String @id @default(cuid())
  personId String
  /// Whose view of the contact this photo is. Equals the owner for the default.
  userId   String

  /// Image bytes, already resized and re-encoded on upload.
  data      Bytes
  mimeType  String
  /// Longest edge in pixels, after resizing. Kept for the img sizing hints.
  width     Int
  height    Int
  /// Cache-busting token for the photo URL; changes whenever the bytes do.
  etag      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([personId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Labels
// ---------------------------------------------------------------------------

/// A user-defined grouping for contacts: "Family", "Book club", "Work".
///
/// Owned by a user rather than global to the install, because two people's
/// "Family" mean different things. A shared contact carries its **owner's**
/// labels, matching how the owner's field definitions and mappings already render
/// it — one Hearth record looks the same to everyone who can see it.
model Label {
  id      String @id @default(cuid())
  ownerId String
  name    String
  /// Chip colour token, resolved in the UI. Null means "pick one from the name".
  color   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  people       PersonLabel[]
  googleGroups LabelGroup[]

  /// Names are the thing users type, filter by and match on import, so they have
  /// to be unique per owner or none of those operations has one answer. This also
  /// serves every lookup by owner, so no separate index is needed.
  @@unique([ownerId, name])
}

/// Which labels are on which contact.
///
/// The label and the contact must share an owner. That cannot be expressed as a
/// constraint here — it spans two rows — so it is enforced in the action layer;
/// see assertLabelsBelongToOwner in src/lib/actions/labels.ts.
model PersonLabel {
  personId String
  labelId  String

  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([personId, labelId])
  /// Drives "every contact with this label".
  @@index([labelId])
}

/// One label's Google contact group, in one Google account.
///
/// Google contact groups are per-account resources: the owner's "Family" and a
/// recipient's "Family" are different objects with different resource names. Since
/// a shared contact lands in every recipient's address book, each account needs its
/// own same-named group — the fan-out PersonSync already does for contacts.
model LabelGroup {
  id      String @id @default(cuid())
  labelId String
  /// Whose Google account this group lives in. Not necessarily the label's owner.
  userId  String

  googleResourceName String
  googleEtag         String?
  googleSyncedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([labelId, userId])
  /// One label per Google group, per account.
  @@unique([userId, googleResourceName])
}

// ---------------------------------------------------------------------------
// Sync bookkeeping
// ---------------------------------------------------------------------------

enum SyncTarget {
  GOOGLE_CONTACT
  GOOGLE_EVENT
  /// A Google contact group, queued when the Hearth label behind it is deleted.
  GOOGLE_CONTACT_GROUP
}

/// Records a remote resource that must be deleted from Google. Written when a
/// synced record is deleted locally, or when "Add to Google" is unchecked — in
/// both cases the local row can no longer tell us what to remove. Consumed by
/// the sync worker (M2/M3); rows are written from M1 onward so nothing leaks.
model SyncTombstone {
  id         String     @id @default(cuid())
  ownerId    String
  target     SyncTarget
  /// people/c1234... for contacts, the event id for calendar events.
  resourceId String
  /// Calendar the event lived on; null for contacts.
  calendarId String?
  etag       String?
  /// Why the delete was queued, for audit: "deleted" | "opted_out".
  reason     String

  attempts      Int       @default(0)
  processedAt   DateTime?
  nextAttemptAt DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, processedAt])
  @@index([target, resourceId])
}

/// Somebody at a gift event who the gifts are FOR.
///
/// Separate from EventAttendee on purpose: a toddler receiving half the presents need
/// not be on the invitation, and plenty of attendees receive nothing. Conflating the
/// two would make the guest list decide the thank-you list.
model EventGiftRecipient {
  eventId  String
  personId String

  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([eventId, personId])
  @@index([personId])
}

/// One present, from one person to another.
///
/// giverId and recipientId both point at Person, so a single table answers "what did
/// Mary give us?" and "what have we given Mary?" without a direction flag — the same
/// trick Relationship uses, and the reason a contact page can show both lists from one
/// query.
///
/// eventId is what separates the two cases the feature was asked for: a Christmas pile
/// is gifts carrying an event, a one-off is the same row without one.
///
/// Who may see a gift is decided by its RECIPIENT: readable if you can read that
/// contact, writable if you can write it. Reusing the existing boundary rather than
/// giving gifts a sharing dimension of their own means a gift for someone your partner
/// shared with you simply appears, with no second set of rules to keep in step.
model Gift {
  id      String @id @default(cuid())
  /// Who recorded it. Kept for provenance; it does not decide who may read it.
  ownerId String

  eventId     String?
  giverId     String

  description String
  notes       String? @db.Text
  /// For a one-off. Gifts at an event take their date from the event.
  receivedOn  DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  event     Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  giver      Person          @relation("GiftGiver", fields: [giverId], references: [id], onDelete: Cascade)
  /// Who it was for. More than one, because a big present is often given to several
  /// people at once — a holiday for the children is one gift and one thank-you, not one
  /// per child.
  recipients GiftRecipient[]

  @@index([eventId])
  @@index([giverId])
  @@index([ownerId])
}

/// One of the people a gift was for, and their own thanks for it.
///
/// Thanking lives here rather than on Gift because a present shared between two children
/// earns two notes, one from each of them: the obligation is personal even when the
/// present was not. Recording it on the gift would let either child's note discharge the
/// other's.
model GiftRecipient {
  giftId   String
  personId String

  /// Set when THIS person's thank-you was sent to the giver, from here.
  ///
  /// Hearth can be certain of it because it did the sending, which is why there is no
  /// checkbox and nothing to remember to tick. Writing the note is the record.
  thankedAt    DateTime?
  /// What they said, kept so the record is a thank-you rather than only a date.
  thankYouNote String?   @db.Text

  gift   Gift   @relation(fields: [giftId], references: [id], onDelete: Cascade)
  person Person @relation("GiftRecipient", fields: [personId], references: [id], onDelete: Cascade)

  @@id([giftId, personId])
  @@index([personId])
}

/// A date Google keeps on a contact that is not their birthday.
///
/// Anniversaries and custom dates. A table rather than a column because there can be
/// several, and a nullable year because Google permits one — "our anniversary, the 12th
/// of June" is a real entry with no year attached.
model PersonGoogleEvent {
  id       String @id @default(cuid())
  personId String
  /// Google's type: "anniversary", or whatever was typed.
  label    String?
  year     Int?
  month    Int
  day      Int
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, order])
}

/// Google's own "relations" — a person's name typed as free text, with a type.
///
/// Deliberately NOT Hearth's Relationship, which links two contacts that both exist and
/// reads correctly from either end. Google's is a string: "Jane" as somebody's spouse,
/// whether or not Jane is in the address book. Conflating them would either invent
/// contacts for names or throw the names away.
model PersonGoogleRelation {
  id       String @id @default(cuid())
  personId String
  /// The name as Google holds it.
  name     String
  /// "spouse", "child", or whatever was typed.
  label    String?
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, order])
}

/// Why a version was recorded. Useful on its own: "changed by the CSV import" answers a
/// question that "changed" does not.
enum PersonVersionSource {
  CREATED
  EDITED
  CSV_IMPORT
  GOOGLE_IMPORT
  TRANSFERRED
}

/// A contact as it stood at one moment.
///
/// A whole snapshot rather than a list of field changes, because a contact is spread over
/// Person, ContactPoint, PersonLabel, PersonGoogleEvent, PersonGoogleRelation and a JSON
/// bag — diffing five tables at write time is machinery that fails quietly, and a snapshot
/// answers "as it was in March" exactly. The diff is derived from two snapshots by a pure
/// function instead, so the timeline costs nothing to store and cannot drift from the data
/// it describes.
///
/// Recorded only when the content actually differs from the previous version. Sync touches
/// updatedAt and the sync columns constantly without changing anything a person wrote, and
/// a history full of "pushed to Google" entries would bury the four edits that matter.
///
/// Cascades on delete. Deleting a contact takes its history with it, which is the honest
/// reading of delete for personal data — the alternative is a record of somebody you
/// believe you removed.
model PersonVersion {
  id       String @id @default(cuid())
  personId String
  /// 1, 2, 3… per contact, so a version has a name a person can use.
  revision Int
  /// Who saved it. Null when Hearth acted on its own behalf.
  byUserId String?
  source   PersonVersionSource

  /// The contact at that moment, shaped by snapshotPerson().
  content Json

  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// SetNull rather than Cascade: a departing user must not erase the history of
  /// contacts they once edited.
  byUser User?  @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  @@unique([personId, revision])
  @@index([personId, createdAt])
  @@index([byUserId])
}
